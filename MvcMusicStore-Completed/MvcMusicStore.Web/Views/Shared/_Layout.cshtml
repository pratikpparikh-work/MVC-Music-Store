<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - ASP.NET MVC Music Store</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div id="header">
        <h1><a href="/">ASP.NET MVC MUSIC STORE</a></h1>
        <ul id="navlist">
            <li class="first"><a asp-controller="Home" asp-action="Index" id="current">Home</a></li>
            <li><a asp-controller="Store" asp-action="Index">Store</a></li>
            <li>
                @* CartSummary ViewComponent - replaces Html.RenderAction("CartSummary", "ShoppingCart") *@
                @await Component.InvokeAsync("CartSummary")
            </li>
            @if (User.IsInRole("Administrator"))
            {
                <li><a asp-controller="StoreManager" asp-action="Index">Admin</a></li>
            }
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <li>
                    <form asp-controller="Account" asp-action="LogOff" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" style="background:none;border:none;cursor:pointer;color:inherit;">
                            Log Off (@User.Identity.Name)
                        </button>
                    </form>
                </li>
            }
            else
            {
                <li><a asp-controller="Account" asp-action="Login">Log On</a></li>
            }
        </ul>
    </div>

    @* GenreMenu ViewComponent - replaces Html.RenderAction("GenreMenu", "Store") *@
    <div id="categories">
        @await Component.InvokeAsync("GenreMenu")
    </div>

    <div id="main">
        @RenderBody()
    </div>

    <div id="footer">
        built with <a href="https://dotnet.microsoft.com/apps/aspnet/mvc">ASP.NET Core MVC 8</a>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    <link href="~/css/site.css" rel="stylesheet" type="text/css" />
    <script src="~/js/jquery-1.5.1.min.js" type="text/javascript"></script>
</head>
<body>
    <div id="header">
        <h1><a href="/">ASP.NET MVC MUSIC STORE</a></h1>
        <ul id="navlist">
            <li class="first"><a href="~/" id="current">Home</a></li>
            <li><a href="~/Store/">Store</a></li>
            <li>@await Component.InvokeAsync("ShoppingCartSummary")</li>
            <li><a href="~/StoreManager/">Admin</a></li>
        </ul>
    </div>

    @await Component.InvokeAsync("GenreMenu")

    <div id="main">
        @RenderBody()
    </div>

    <div id="footer">
        built with <a href="http://asp.net/mvc">ASP.NET Core MVC</a>
    </div>
</body>
</html>

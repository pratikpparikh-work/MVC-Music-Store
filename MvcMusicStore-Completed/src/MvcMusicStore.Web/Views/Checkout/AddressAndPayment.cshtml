@model MvcMusicStore.Domain.Entities.Order

@{
    ViewBag.Title = "Address and Payment";
}

<h2>Address and Payment</h2>

<form asp-action="AddressAndPayment" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <fieldset>
        <legend>Shipping Information</legend>

        <div class="editor-label">
            <label asp-for="FirstName"></label>
        </div>
        <div class="editor-field">
            <input asp-for="FirstName" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="editor-label">
            <label asp-for="LastName"></label>
        </div>
        <div class="editor-field">
            <input asp-for="LastName" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="editor-label">
            <label asp-for="Address"></label>
        </div>
        <div class="editor-field">
            <input asp-for="Address" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="editor-label">
            <label asp-for="City"></label>
        </div>
        <div class="editor-field">
            <input asp-for="City" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>

        <div class="editor-label">
            <label asp-for="State"></label>
        </div>
        <div class="editor-field">
            <input asp-for="State" />
            <span asp-validation-for="State" class="text-danger"></span>
        </div>

        <div class="editor-label">
            <label asp-for="PostalCode"></label>
        </div>
        <div class="editor-field">
            <input asp-for="PostalCode" />
            <span asp-validation-for="PostalCode" class="text-danger"></span>
        </div>

        <div class="editor-label">
            <label asp-for="Country"></label>
        </div>
        <div class="editor-field">
            <input asp-for="Country" />
            <span asp-validation-for="Country" class="text-danger"></span>
        </div>

        <div class="editor-label">
            <label asp-for="Phone"></label>
        </div>
        <div class="editor-field">
            <input asp-for="Phone" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="editor-label">
            <label asp-for="Email"></label>
        </div>
        <div class="editor-field">
            <input asp-for="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </fieldset>

    <fieldset>
        <legend>Payment</legend>
        <p>Order free music today by entering the promo code: <strong>FREE</strong></p>
        <div class="editor-label">
            <label for="PromoCode">Promo Code</label>
        </div>
        <div class="editor-field">
            <input type="text" id="PromoCode" name="PromoCode" />
        </div>
    </fieldset>

    <input type="submit" value="Submit Order" />
</form>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MvcMusicStore.Web</RootNamespace>
    <AssemblyName>MvcMusicStore.Web</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MvcMusicStore.Application\MvcMusicStore.Application.csproj" />
    <ProjectReference Include="..\MvcMusicStore.Infrastructure\MvcMusicStore.Infrastructure.csproj" />
    <ProjectReference Include="..\MvcMusicStore.Domain\MvcMusicStore.Domain.csproj" />
  </ItemGroup>

</Project>
